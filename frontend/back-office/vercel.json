{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --prefix ../.. && npm ci",
  "buildCommand": "npm exec next build -- --webpack",
  "outputDirectory": ".next",
  "functions": {
    "src/pages/api/operational/**/*.ts": {
      "maxDuration": 60
    }
  }
}
