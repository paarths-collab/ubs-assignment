# Server-only. Never prefix credentials with NEXT_PUBLIC_.
# The connected workspace runs its existing AI backend inside Next.js.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Alternatively: LLM_PROVIDER=groq and GROQ_API_KEY=...
# Shared LLM_API_KEY and LLM_MODEL are supported as fallbacks.

# Optional separate account/upload service from the supplied full app.
BACKEND_URL=http://127.0.0.1:8000

# Local legacy-page forwarding only; operational AI does not use this URL.
OPERATIONAL_BACKEND_URL=http://127.0.0.1:4311
