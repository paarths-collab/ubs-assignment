# Copy to .env.local for local dev, or set in the Vercel project's
# Environment Variables. This is a build-time PUBLIC value (an origin, not a
# secret) — Vite inlines it into the bundle at build time.

# Origin of the Fastify backend that serves /api/* (deployed on Render).
# No trailing slash. Leave empty for local dev to fall back to
# http://localhost:3001.
#
# Local dev example:
# VITE_API_BASE_URL=http://localhost:3001
#
# Production (Vercel) example:
# VITE_API_BASE_URL=https://risk-stream-explorer-api.onrender.com
VITE_API_BASE_URL=
