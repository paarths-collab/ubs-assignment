{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:overview",
  "outputDirectory": "frontend/risk-executive-overview/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": ["backend/risk-executive-overview/data/**"]
    }
  }
}
