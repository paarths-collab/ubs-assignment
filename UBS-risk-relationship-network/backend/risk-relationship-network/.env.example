# Copy to .env and fill in. Never commit .env — it holds a live API key.
PORT=3000
NODE_ENV=development

# --- AI provider (OpenAI-compatible) --------------------------------------
# Any OpenAI-compatible chat-completions API works here — this is an
# environment change, not a code change. Configured for OpenRouter below;
# to use Groq instead, set AI_BASE_URL=https://api.groq.com/openai/v1 and
# AI_MODEL to a Groq model id.
# Create a key at https://openrouter.ai/settings/keys
# AI_MODEL must be an exact model slug from https://openrouter.ai/models
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-chat
AI_TIMEOUT_MS=20000

# Maximum representative events included in an AI prompt. Aggregate metrics
# always cover the whole scope regardless of this cap.
MAX_AI_EVENT_SAMPLES=30

# --- Security --------------------------------------------------------------
# Comma-separated. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:5185,http://localhost:4173

# Opening frontend/dist/index.html directly from disk sends "Origin: null".
# Enable only for local file:// testing; keep false in production.
ALLOW_FILE_ORIGIN=false

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

MAX_EVENT_IDS=1000
MAX_QUESTION_LENGTH=500
JSON_BODY_LIMIT=100kb

# --- Data ------------------------------------------------------------------
# Defaults to the frontend package's copy of the four brain datasets.
# BRAIN_DATA_DIR=../../frontend/risk-relationship-network/data
