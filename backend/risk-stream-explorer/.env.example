# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# LLM provider (see src/config/llm.ts)
#
# All supported providers speak the same OpenAI-compatible chat/completions
# protocol, so switching is a key + model change only. Keys are read
# server-side and never sent to the browser.
# ---------------------------------------------------------------------------

# Component 4 uses OpenRouter for every AI call.
LLM_PROVIDER=openrouter

# OpenRouter key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug. Pinned rather than "...-latest" so behaviour can't shift
# between writing and review. Browse slugs at https://openrouter.ai/models
#   deepseek/deepseek-v4-flash-0731  1.31M ctx  ~$0.065/M in, $0.18/M out
#   deepseek/deepseek-v4-pro-0813    1.05M ctx  pricier, stronger reasoning
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# Optional: override the endpoint entirely for a provider not listed above.
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional: OpenRouter attribution shown on its public leaderboards.
# LLM_REFERER=http://localhost:3001
# LLM_TITLE=UBS Operational Risk Workbench

# --- Legacy Groq settings (unused when LLM_PROVIDER=openrouter) -------------
# Get one at https://console.groq.com. Never expose this to the browser.
GROQ_API_KEY=

# Legacy var, still honoured as a fallback for LLM_MODEL when provider=groq.
GROQ_MODEL=openai/gpt-oss-120b

# Port the backend HTTP server listens on.
PORT=3001

# Comma-separated list of origins allowed by CORS to call this API. Defaults
# to the Vite dev server ports this project uses plus "null" (the Origin
# browsers send for a `file://` page's fetch calls) so the single-file
# production build can be opened directly.
CORS_ORIGIN=http://localhost:5173,http://localhost:5183,http://localhost:5187,http://localhost:5199,null

# Timeout (ms) for a single model call before it is aborted.
AI_TIMEOUT_MS=15000

# How long (ms) a successful AI pattern-analysis result is cached in memory.
AI_CACHE_TTL_MS=3600000
