NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# ---------------------------------------------------------------------------
# LLM provider
#
# Leave every key unset to run with the AI features disabled — the dashboard
# and all factual endpoints work without them; the AI panel simply reports
# that it is not configured.
#
# LLM_PROVIDER selects the backend explicitly. OpenRouter/DeepSeek is the
# default; use Groq only for legacy compatibility when explicitly selected.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# --- Option A: OpenRouter (OpenAI-compatible; no extra SDK needed) ---------
# Key: https://openrouter.ai/keys
# Model slug: copy the exact id from https://openrouter.ai/models
#   e.g. deepseek/deepseek-v4-flash  ·  deepseek/deepseek-v4-flash-0731
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Option B: Groq --------------------------------------------------------
# Key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000
GROQ_REASONING_EFFORT=low
